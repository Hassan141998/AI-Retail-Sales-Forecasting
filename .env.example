# ============================================================
# Sales Forecast - Environment Example (copy to .env)
# ============================================================

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NEON_DB_HOST=your-neon-host
NEON_DB_PORT=5432
NEON_DB_NAME=salesforecast
NEON_DB_USER=your_user
NEON_DB_PASSWORD=your_password

APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change-this-in-production
DEBUG=True

ARIMA_ORDER_P=5
ARIMA_ORDER_D=1
ARIMA_ORDER_Q=0
LSTM_EPOCHS=50
LSTM_BATCH_SIZE=32
LSTM_LOOKBACK=60
LSTM_UNITS=128
MODEL_SAVE_PATH=./models/saved/

DATA_PATH=./data/retail_sales.csv
TRAIN_SPLIT=0.8
FORECAST_HORIZON=30

VERCEL_URL=https://your-project.vercel.app
API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
